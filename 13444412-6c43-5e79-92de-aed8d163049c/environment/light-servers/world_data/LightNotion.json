  },
  {
   "id": "block-tsl-002",
   "page_id": "page-tsl-revops",
   "parent_block_id": null,
   "type": "paragraph",
   "text": "Home of the price book, plan features and the pricing committee's decisions. The billing desk and Sales read prices from here.",
   "order": 1,
   "created_time": "2026-10-01T09:00:00.000Z",
   "last_edited_time": "2026-10-01T09:00:00.000Z",
   "has_children": false,
   "checked": null
  },
  {
   "id": "block-tsl-003",
   "page_id": "page-tsl-revops",
   "parent_block_id": null,
   "type": "paragraph",
   "text": "Price book entries are owned by Anouk Brennan-Price (RevOps). Each entry is one plan and billing interval; a pricing committee decision is entered on the price card it changes on the day it is taken.",
   "order": 2,
   "created_time": "2026-10-01T09:00:00.000Z",
   "last_edited_time": "2026-10-01T09:00:00.000Z",
   "has_children": false,
   "checked": null
  },
  {
   "id": "block-tsl-004",
   "page_id": "page-tsl-pb-line-monthly",
   "parent_block_id": null,
   "type": "heading_2",
   "text": "Line Monthly — price card",
   "order": 0,
   "created_time": "2026-10-01T09:00:00.000Z",
   "last_edited_time": "2026-10-01T09:00:00.000Z",
   "has_children": false,
   "checked": null
  },
  {
   "id": "block-tsl-005",
   "page_id": "page-tsl-pb-line-monthly",
   "parent_block_id": null,
   "type": "paragraph",
   "text": "List price £12.00 per seat per month. In force since 1 March 2025 (pricing committee PRC-2025-02).",
   "order": 1,
   "created_time": "2026-10-01T09:00:00.000Z",
   "last_edited_time": "2026-10-01T09:00:00.000Z",
   "has_children": false,
   "checked": null
  },
  {
   "id": "block-tsl-006",
   "page_id": "page-tsl-pb-line-monthly",
   "parent_block_id": null,
   "type": "paragraph",
   "text": "Prices exclude VAT. Seats are editor seats; viewer links are free on every plan.",
   "order": 2,
   "created_time": "2026-10-01T09:00:00.000Z",
   "last_edited_time": "2026-10-01T09:00:00.000Z",
   "has_children": false,
   "checked": null
  },
