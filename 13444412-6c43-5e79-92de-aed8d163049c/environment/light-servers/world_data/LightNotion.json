  {
   "id": "block-tsl-038",
   "page_id": "page-tsl-pb-mosaic-annual",
   "parent_block_id": null,
   "type": "paragraph",
   "text": "From 1 January 2027 the Mosaic Annual list price is £372.00 per seat per year (£31.00 per seat per month equivalent). It applies to every period that starts on or after 1 January 2027: renewals, new subscriptions and changes taking effect from that date. Periods that start before then keep the current price. Approved by the pricing committee on 30 September 2026 (PRC-2026-09); customers notified on 5 October 2026.",
   "order": 4,
   "created_time": "2026-10-01T09:00:00.000Z",
   "last_edited_time": "2026-10-01T09:00:00.000Z",
   "has_children": false,
   "checked": null
  },
