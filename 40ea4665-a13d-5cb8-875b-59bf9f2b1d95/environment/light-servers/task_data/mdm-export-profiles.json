      "agreement": "in-house (see amr-export-format-readme.md)"
    },
    {
      "collector": "Kestrel Data Services",
      "file_glob": "kestrel-hh-delivery-*.csv",
      "columns": {
        "supply_no": "mpan",
        "msn": "msn",
        "timestamp": "ts_utc",
        "channel_1": "a_plus",
        "channel_2": "r_plus",
        "status": "qual"
      },
      "timestamp_format": "%Y-%m-%d %H:%M",
      "agreement": "KDS-HRM-2026 Schedule 2"
    },
    {
      "collector": "Varden Metering Services",
      "file_glob": "varden-sched3-*.csv",
      "columns": {
        "supply_no": "MPAN",
        "msn": "MSN",
        "timestamp": "READ_TS_UTC",
        "channel_1": "AI",
        "channel_2": "RI",
        "status": "FLAG"
      },
      "timestamp_format": "%Y%m%d%H%M",
      "agreement": "VMS-DCA-2026 Schedule 3"
