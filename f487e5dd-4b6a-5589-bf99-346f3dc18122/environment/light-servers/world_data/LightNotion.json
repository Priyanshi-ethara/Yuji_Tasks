 "blocks": [
  {
   "id": "blk-pe-home-1",
   "page_id": "pg-proc-eng-home",
   "parent_block_id": null,
   "type": "paragraph",
   "text": "The Inverter catalogue holds one page per approved inverter model with the limits the design desk applies under DS-6. Pages are kept current by procurement engineering from manufacturer information; manufacturer notices are recorded on the model's own page.",
   "order": 0,
   "created_time": "2024-03-01T09:00:00.000Z",
   "last_edited_time": "2026-02-02T09:00:00.000Z",
   "has_children": false,
   "checked": null
  },
  {
   "id": "blk-volta-8k-1",
   "page_id": "pg-inv-volta-8k",
   "parent_block_id": null,
   "type": "heading_2",
   "text": "Volta 8K — controlled limits for DS-6 reviews (procurement engineering).",
   "order": 0,
   "created_time": "2024-03-04T09:00:00.000Z",
   "last_edited_time": "2026-05-14T09:20:00.000Z",
   "has_children": false,
   "checked": null
  },
  {
   "id": "blk-volta-8k-2",
   "page_id": "pg-inv-volta-8k",
   "parent_block_id": null,
   "type": "paragraph",
   "text": "Maximum DC input voltage: 600 V.",
   "order": 1,
   "created_time": "2024-03-04T09:00:00.000Z",
   "last_edited_time": "2026-05-14T09:20:00.000Z",
   "has_children": false,
   "checked": null
  },
  {
   "id": "blk-volta-8k-3",
   "page_id": "pg-inv-volta-8k",
   "parent_block_id": null,
   "type": "paragraph",
   "text": "MPPT operating range: 200 V to 550 V (MPPT lower bound 200 V).",
   "order": 2,
   "created_time": "2024-03-04T09:00:00.000Z",
   "last_edited_time": "2026-05-14T09:20:00.000Z",
   "has_children": false,
   "checked": null
  },
  {
   "id": "blk-volta-8k-4",
   "page_id": "pg-inv-volta-8k",
   "parent_block_id": null,
   "type": "paragraph",
   "text": "Maximum short-circuit input current per MPPT tracker: 20 A. Trackers: 2; strings per tracker: up to 1.",
   "order": 3,
   "created_time": "2024-03-04T09:00:00.000Z",
   "last_edited_time": "2026-05-14T09:20:00.000Z",
   "has_children": false,
   "checked": null
  },
  {
   "id": "blk-volta-8k-5",
