   "reply_count": 0,
   "reactions": []
  },
  {
   "ts": "1794505500.000108",
   "channel_id": "C0SORDATA",
   "user_id": "U0SORBASTIEN",
   "text": "Nightly PII sweep finished. Everything booked for the 19 Nov window is Pass.",
   "thread_ts": null,
   "reply_count": 0,
   "reactions": []
  },
  {
